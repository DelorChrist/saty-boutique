# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASS=your_database_password
DB_NAME=saty_boutique

# JWT Secret - IMPORTANT: Change this to a strong random string in production
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_strong_random_secret_in_production

# CORS Origins (comma-separated list for production)
# Example: https://satyboutique.com,https://www.satyboutique.com
CORS_ORIGINS=http://localhost:4200

# Admin Credentials (used for initial setup)
ADMIN_EMAIL=admin@satyboutique.com
ADMIN_PASSWORD=change_this_password_in_production
